# Falcon Eye configuration template.
# Copy to .env and edit:   cp .env.example .env     (Windows: copy .env.example .env)
# NEVER commit your real .env file and never put real secrets in this template.

# "development" (default) or "production". Production refuses to start with weak or missing secrets.
ENVIRONMENT=development

# Database. If you leave this empty in development, a local SQLite file (falcon_eye.db) is used.
# PostgreSQL example:  postgresql+psycopg://falconeye:CHANGE_ME@localhost:5432/falconeye
DATABASE_URL=

# Secret used to sign login tokens. Required in production (32+ characters).
# Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Login token lifetime in minutes (the web app renews it while you work).
ACCESS_TOKEN_MINUTES=60

# Browser origins allowed to call the API (comma separated). Never use *.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when Falcon Eye is served over HTTPS.
COOKIE_SECURE=false

# Set to true only when a trusted reverse proxy (like the bundled nginx) sets X-Forwarded-For.
TRUST_PROXY=false

# Swagger docs at /docs (true/false). Consider false in production.
ENABLE_API_DOCS=true

# Brute-force protection.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# How many requests one agent may send per minute.
AGENT_RATE_LIMIT_PER_MINUTE=120

# Approval requests expire after this many hours; an agent counts as "Connected" if seen within this many minutes.
APPROVAL_TTL_HOURS=24
AGENT_CONNECTED_MINUTES=15

# AI support assistant (optional). Without LLM_API_KEY it answers from the documentation only.
# LLM_PROVIDER: anthropic, or openai (also works for OpenAI-compatible servers via LLM_BASE_URL)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Used only by docker-compose.yml for the PostgreSQL container.
POSTGRES_USER=falconeye
POSTGRES_PASSWORD=
POSTGRES_DB=falconeye
